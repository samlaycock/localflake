# Snowflake Scripting: anonymous blocks and EXECUTE IMMEDIATE. Expected results
# are the examples in Snowflake's Snowflake Scripting documentation.

query types
DECLARE
  radius_of_circle FLOAT;
  area_of_circle FLOAT;
BEGIN
  radius_of_circle := 3;
  area_of_circle := pi() * radius_of_circle * radius_of_circle;
  RETURN area_of_circle;
END
----
FLOAT
28.274333882308138

query
EXECUTE IMMEDIATE $$
DECLARE
  radius_of_circle FLOAT;
  area_of_circle FLOAT;
BEGIN
  radius_of_circle := 3;
  area_of_circle := PI() * radius_of_circle * radius_of_circle;
  RETURN area_of_circle;
END;
$$
----
28.274333882308138

query
