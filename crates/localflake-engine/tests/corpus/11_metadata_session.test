# SHOW, DESCRIBE, INFORMATION_SCHEMA, identifiers, session state.

statement ok
create table people (id int comment 'pk', "Mixed Case" varchar, nm varchar(10))

statement ok
create schema other

statement ok
create table other.things (x int)

statement ok
use schema public

query
select table_name, table_schema, table_type from information_schema.tables where table_schema in ('PUBLIC', 'OTHER') order by 1
----
PEOPLE|PUBLIC|BASE TABLE
THINGS|OTHER|BASE TABLE

query
select count(*) from information_schema.schemata where schema_name in ('PUBLIC', 'OTHER', 'INFORMATION_SCHEMA')
----
3

query
select "Mixed Case" from people
----

error 000904
select mixed_case from people

error 000904
select "id" from people

query
select "ID", Id, id from (select 1 as id)
----
1|1|1

query
select "a"."b" from (select 1 as "b") as "a"
----
1

query
select current_database(), current_schema(), current_role(), current_warehouse() is null
----
CORPUS_11_METADATA_SESSION|PUBLIC|ACCOUNTADMIN|true

statement ok
use schema other

query
select current_schema(), count(*) from things
----
OTHER|0

statement ok
use schema public

statement ok
set (a, b) = (1, 'two')

query
select $a + 1, $b
----
2|two

statement ok
set c = (select count(*) from people)

query
select $c
----
0

statement ok
unset a

error
select $a

statement ok
alter session set timezone = 'UTC' query_tag = 'corpus'

statement ok
show columns in table people

