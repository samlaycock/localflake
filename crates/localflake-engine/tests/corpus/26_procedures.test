RETURNS VARCHAR
LANGUAGE SQL
AS
BEGIN
  RETURN 'number ' || v;
END;

statement ok
CREATE OR REPLACE PROCEDURE describe_value(v VARCHAR)
RETURNS VARCHAR
LANGUAGE SQL
AS
BEGIN
  RETURN 'text ' || v;
END;

statement ok
CREATE OR REPLACE PROCEDURE describe_value(a NUMBER, b NUMBER)
RETURNS VARCHAR
LANGUAGE SQL
AS
BEGIN
  RETURN 'sum ' || (a + b);
END;

query
CALL describe_value(5)
----
number 5

query
CALL describe_value('five')
----
text five

query
CALL describe_value(2, 3)
----
sum 5

