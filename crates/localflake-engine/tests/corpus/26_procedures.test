CREATE OR REPLACE PROCEDURE simple_out_sp_demo(xout OUT NUMBER)
  RETURNS NUMBER
  LANGUAGE SQL
AS
BEGIN
  xout := 2;
  RETURN xout;
END;

statement ok
CREATE OR REPLACE PROCEDURE simple_out_sp_caller()
  RETURNS NUMBER
  LANGUAGE SQL
AS
BEGIN
  LET x NUMBER := 1;
  CALL simple_out_sp_demo(:x);
  RETURN x;
END;

query
CALL simple_out_sp_caller()
----
2

