CREATE OR REPLACE PROCEDURE one_liner(message VARCHAR) RETURNS VARCHAR LANGUAGE SQL EXECUTE AS CALLER AS 'BEGIN RETURN message; END'

query
DESCRIBE PROCEDURE one_liner(VARCHAR)
----
signature|(MESSAGE VARCHAR)
returns|VARCHAR
language|SQL
null handling|CALLED ON NULL INPUT
volatility|VOLATILE
execute as|CALLER
body|BEGIN RETURN message; END

query
CALL one_liner('quoted body')
----
quoted body

error 002003
DESCRIBE PROCEDURE one_liner(NUMBER)

query
SELECT procedure_name, argument_signature, data_type, procedure_language
FROM information_schema.procedures WHERE procedure_name LIKE 'RETURN%'
----
RETURN_GREATER|(NUMBER_1 INTEGER, NUMBER_2 INTEGER)|INTEGER|SQL

# The hidden schema that stores procedures isn't visible.
query
SELECT count(*) FROM information_schema.schemata WHERE schema_name ILIKE '%localflake%'
----
0

query
SELECT count(*) FROM information_schema.tables WHERE table_name = 'PROCEDURES'
----
0

# RETURNS NULL ON NULL INPUT skips the body.
statement ok
CREATE OR REPLACE PROCEDURE strict_proc(x INTEGER)
RETURNS VARCHAR
LANGUAGE SQL
STRICT
AS
BEGIN
  RETURN 'ran';
END;

query
CALL strict_proc(NULL)
----
NULL

query
CALL strict_proc(1)
----
ran

# NOT NULL return types reject NULL.
statement ok
CREATE OR REPLACE PROCEDURE returns_null()
RETURNS VARCHAR NOT NULL
LANGUAGE SQL
AS
BEGIN
  RETURN NULL;
END;

error 100072
CALL returns_null()

# An exception a procedure doesn't handle.
statement ok
CREATE OR REPLACE PROCEDURE raise_it()
RETURNS VARCHAR
LANGUAGE SQL
AS
DECLARE
  my_exception EXCEPTION (-20002, 'Raised MY_EXCEPTION.');
BEGIN
  RAISE my_exception;
END;

error Uncaught exception of type 'MY_EXCEPTION' on line 4 at position 2 : Raised MY_EXCEPTION.
CALL raise_it()

query
DECLARE
  result VARCHAR;
BEGIN
  CALL raise_it();
  RETURN 'unreachable';
EXCEPTION
  WHEN STATEMENT_ERROR THEN RETURN SQLCODE;
END
----
-20002

