statement ok
CREATE OR REPLACE PROCEDURE sales_total_out_sp_demo(
    id INT,
    quarter VARCHAR(20),
    total_sales OUT NUMBER(38,0))
  RETURNS STRING
  LANGUAGE SQL
AS
BEGIN
  SELECT SUM(amount) INTO total_sales FROM quarterly_sales
    WHERE empid = :id AND
          quarter = :quarter;
  RETURN 'Done';
END;

statement ok
CREATE OR REPLACE PROCEDURE emp_quarter_calling_sp_demo(
    id INT,
    quarter VARCHAR(20))
  RETURNS STRING
  LANGUAGE SQL
AS
BEGIN
  LET x NUMBER(38,0) := 0;
  CALL sales_total_out_sp_demo(:id, :quarter, :x);
  RETURN 'Total sales for employee ' || id || ' in quarter ' || quarter || ': ' || x;
END;

query
CALL emp_quarter_calling_sp_demo(2, '2023_Q4')
----
Total sales for employee 2 in quarter 2023_Q4: 5300

statement ok
CREATE OR REPLACE PROCEDURE power_of_2()
RETURNS NUMBER(8, 0)
LANGUAGE SQL
AS
$$
DECLARE
  counter NUMBER(8, 0);
  power_of_2 NUMBER(8, 0);
BEGIN
  counter := 1;
  power_of_2 := 1;
  WHILE (counter <= 8) DO
    power_of_2 := power_of_2 * 2;
    counter := counter + 1;
  END WHILE;
  RETURN power_of_2;
END;
$$

query
CALL power_of_2()
----
256

# A procedure's value, INTO a caller's variable.
query
DECLARE
  greater INTEGER;
BEGIN
  CALL return_greater(10, 7) INTO :greater;
  RETURN greater * 2;
END
----
20

# A procedure's table, as a RESULTSET.
query
DECLARE
  res RESULTSET DEFAULT (CALL find_invoice_by_id('1'));
  c CURSOR FOR res;
  total NUMBER(12, 2) DEFAULT 0;
BEGIN
  FOR r IN c DO
    total := total + r.price;
  END FOR;
  RETURN total;
END
----
11.11

# Recursion.
statement ok
CREATE OR REPLACE PROCEDURE factorial(n INTEGER)
RETURNS INTEGER
LANGUAGE SQL
AS
DECLARE
  result INTEGER;
BEGIN
  IF (n <= 1) THEN
    RETURN 1;
  END IF;
  CALL factorial(:n - 1) INTO :result;
  RETURN n * result;
END;

query
CALL factorial(10)
----
3628800

statement ok
CREATE OR REPLACE PROCEDURE countdown(n INTEGER)
RETURNS INTEGER
LANGUAGE SQL
AS
DECLARE
  r INTEGER;
BEGIN
  IF (n <= 0) THEN
    RETURN 0;
  END IF;
  CALL countdown(:n - 1) INTO :r;
  RETURN r + 1;
END;

query
CALL countdown(49)
----
49

error 100389
CALL countdown(60)

