# Stored procedures written in Snowflake Scripting. Expected results are the
# examples in Snowflake's stored procedure and Snowflake Scripting documentation.

statement ok
CREATE OR REPLACE PROCEDURE output_message(message VARCHAR)
RETURNS VARCHAR NOT NULL
LANGUAGE SQL
AS
BEGIN
  RETURN message;
END;

query types
CALL output_message('Hello World')
----
VARCHAR
Hello World

statement ok
CREATE OR REPLACE PROCEDURE output_message(message VARCHAR)
RETURNS VARCHAR NOT NULL
LANGUAGE SQL
AS
$$
BEGIN
  RETURN message;
END;
$$

query
CALL output_message('Hello again')
----
Hello again

statement ok
CREATE OR REPLACE PROCEDURE return_greater(number_1 INTEGER, number_2 INTEGER)
RETURNS INTEGER NOT NULL
LANGUAGE SQL
AS
BEGIN
  IF (number_1 > number_2) THEN
    RETURN number_1;
  ELSE
    RETURN number_2;
  END IF;
END;

query types
CALL return_greater(2, 3)
----
NUMBER(*,0)
3

