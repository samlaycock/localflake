# MATCH_RECOGNIZE row pattern matching.

statement ok
create table stock (company varchar, d int, price int)

statement ok
insert into stock values
  ('acme', 1, 10), ('acme', 2, 8), ('acme', 3, 6), ('acme', 4, 9), ('acme', 5, 12), ('acme', 6, 11),
  ('beta', 1, 5), ('beta', 2, 4), ('beta', 3, 6)

query
select * from stock match_recognize (
  partition by company order by d
  measures match_number() as m, first(d) as start_d, last(d) as end_d, count(*) as n,
           last(down.price) as bottom, max(up.price) as top
  one row per match
  pattern (start down+ up+)
  define down as price < prev(price), up as price > prev(price)
) order by company, m
----
acme|1|1|5|5|6|12
beta|1|1|3|3|4|6

query
select company, d, price, classifier, m from stock match_recognize (
  partition by company order by d
  measures classifier() as classifier, match_number() as m
  all rows per match
  pattern (down+ up)
  define down as price < prev(price), up as price > prev(price)
) order by company, d
----
acme|2|8|DOWN|1
acme|3|6|DOWN|1
acme|4|9|UP|1
beta|2|4|DOWN|1
beta|3|6|UP|1

query
select count(*) from stock match_recognize (
  order by company, d
  measures match_number() as m
  one row per match
  after match skip to next row
  pattern (a b)
  define a as price > 0, b as price > 0
)
----
8

query
select m, n from stock match_recognize (
  partition by company order by d
  measures match_number() as m, count(*) as n
  one row per match
  pattern (^ x{2})
  define x as true
) order by m, n
----
1|2
1|2
