# VECTOR(INT, n) and VECTOR(FLOAT, n), and the vector similarity functions.
# Inputs are exact in 32-bit floats, so results don't depend on rounding.

statement ok
create table vecs (id int, i vector(int, 3), f vector(float, 3))

statement ok
insert into vecs select 1, [1, 2, 3]::vector(int, 3), [0.5, 1.5, -2]::vector(float, 3)

statement ok
insert into vecs select 2, [4, 5, 6]::vector(int, 3), [1, 1, 1]::vector(float, 3)

statement ok
insert into vecs (id) values (3)

query types
select i, f from vecs order by id
----
VECTOR(INT, 3)|VECTOR(FLOAT, 3)
[1,2,3]|[0.5,1.5,-2]
[4,5,6]|[1,1,1]
NULL|NULL

query types
select [1, 2]::vector(int, 2), [1.25, -3]::vector(float, 2)
----
VECTOR(INT, 2)|VECTOR(FLOAT, 2)
[1,2]|[1.25,-3]

query types
select vector_inner_product(a.i, b.i), vector_l1_distance(a.i, b.i), vector_l2_distance(a.i, b.i)
from vecs a, vecs b where a.id = 1 and b.id = 2
----
FLOAT|FLOAT|FLOAT
32|9|5.196152422706632

query
select vector_cosine_similarity(a.i, b.i) from vecs a, vecs b where a.id = 1 and b.id = 2
----
0.9746318461970762

query
select vector_inner_product(f, [2, 2, 2]::vector(float, 3)), vector_l1_distance(f, [1, 1, 1]::vector(float, 3)),
    vector_l2_distance(f, f), vector_cosine_similarity(f, f)
from vecs where id = 1
----
0|4|0|1

query
select vector_inner_product(i, i) from vecs where id = 3
----
NULL

query
select i::array, [0.5, -2.5]::vector(float, 2)::array, array_size(i::array) from vecs where id = 1
----
[1,2,3]|[0.5,-2.5]|3

query
select column_name, data_type from information_schema.columns where table_name = 'VECS' order by ordinal_position
----
ID|NUMBER
I|VECTOR
F|VECTOR

statement ok
desc table vecs

query
select "name", "type" from table(result_scan(last_query_id()))
----
ID|NUMBER(38,0)
I|VECTOR(INT, 3)
F|VECTOR(FLOAT, 3)

error
select [1, 2]::vector(int, 3)

error
select vector_l2_distance([1, 2]::vector(float, 2), [1, 2, 3]::vector(float, 3))

error
create table bad (v vector(varchar, 3))

statement ok
create table vector_data (id int, category varchar, embedding vector(float, 3))

statement ok
insert into vector_data select 1, 'A', [2.0, 4.0, 6.0]::vector(float, 3) union all select 2, 'A', [4.0, 8.0, 12.0]::vector(float, 3) union all select 3, 'B', [1.0, 2.0, 3.0]::vector(float, 3) union all select 4, 'B', [3.0, 6.0, 9.0]::vector(float, 3) union all select 5, 'B', null

query types
select category, vector_avg(embedding), vector_sum(embedding) from vector_data group by category order by category
----
VARCHAR|VECTOR(FLOAT, 3)|VECTOR(FLOAT, 3)
A|[3,6,9]|[6,12,18]
B|[2,4,6]|[4,8,12]

query
select vector_min(embedding), vector_max(embedding), vector_avg(embedding) from vector_data
----
[1,2,3]|[4,8,12]|[2.5,5,7.5]

statement ok
create table int_vector_data (id int, vec vector(int, 2))

statement ok
insert into int_vector_data select 1, [1, 3]::vector(int, 2) union all select 2, [2, 4]::vector(int, 2)

query types
select vector_avg(vec), vector_sum(vec), vector_max(vec) from int_vector_data
----
VECTOR(FLOAT, 2)|VECTOR(INT, 2)|VECTOR(INT, 2)
[1.5,3.5]|[3,7]|[2,4]

query types
select vector_sum(vec) from int_vector_data where id > 2
----
VECTOR(INT, 2)
NULL

query types
select vector_normalize([3, 4]::vector(int, 2)), vector_truncate([1, 2, 3]::vector(int, 3), 2)
----
VECTOR(FLOAT, 2)|VECTOR(INT, 2)
[0.6,0.8]|[1,2]

query types
select vector_normalize(embedding) from vector_data where id = 5
----
VECTOR(FLOAT, 3)
NULL

error
select vector_truncate([1, 2, 3]::vector(int, 3), 4)
