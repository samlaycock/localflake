# Dates, times and timestamps. The session time zone is UTC.

query types
select '2024-03-15'::date, '12:34:56'::time, '2024-03-15 10:11:12.5'::timestamp_ntz, '2024-03-15 10:11:12'::timestamp
----
DATE|TIME|TIMESTAMP_NTZ|TIMESTAMP_NTZ
2024-03-15|12:34:56|2024-03-15 10:11:12.5|2024-03-15 10:11:12

query
select date_part(year, '2024-03-15'::date), extract(month from '2024-03-15'::date), day('2024-03-15'::date), dayofmonth('2024-03-15'::date)
----
2024|3|15|15

query
select dayofweek('2024-03-15'::date), dayofweekiso('2024-03-15'::date), dayofyear('2024-03-15'::date), quarter('2024-03-15'::date)
----
5|5|75|1

query
select weekofyear('2024-03-15'::date), weekiso('2024-03-15'::date), yearofweekiso('2024-12-30'::date), week('2024-01-01'::date)
----
11|11|2025|1

query
select hour('2024-03-15 10:11:12'::timestamp), minute('2024-03-15 10:11:12'::timestamp), second('2024-03-15 10:11:12'::timestamp), date_part(epoch_second, '2024-03-15 10:11:12'::timestamp)
----
10|11|12|1710497472

query
select extract(epoch from '2024-03-15 10:11:12'::timestamp), date_part('epoch_millisecond', '1970-01-01 00:00:01.5'::timestamp), date_part(nanosecond, '2024-01-01 00:00:00.123'::timestamp)
----
1710497472|1500|123000000

query
select dateadd(year, 1, '2024-02-29'::date), dateadd(month, -1, '2024-03-31'::date), dateadd('day', 10, '2024-02-25'::date), timestampadd(hour, 25, '2024-01-01'::date)
----
2025-02-28|2024-02-29|2024-03-06|2024-01-02 01:00:00

query
select datediff(year, '2023-12-31'::date, '2024-01-01'::date), datediff(month, '2024-01-31'::date, '2024-03-01'::date), datediff(day, '2024-03-01'::date, '2024-02-01'::date)
----
1|2|-29

query
select datediff(hour, '2024-01-01 10:59'::timestamp, '2024-01-01 11:00'::timestamp), datediff(minute, '2024-01-01 10:00:59'::timestamp, '2024-01-01 10:01:00'::timestamp), timestampdiff(second, '2024-01-01'::timestamp, '2024-01-01 00:01:00'::timestamp)
----
1|1|60

query
select datediff(week, '2024-03-09'::date, '2024-03-11'::date), datediff(quarter, '2024-03-31'::date, '2024-04-01'::date)
----
1|1

query
select add_months('2024-01-31'::date, 1), months_between('2024-03-15'::date, '2024-02-15'::date), last_day('2024-02-10'::date, 'year'), last_day('2024-05-10'::date, 'quarter')
----
2024-02-29|1.000000|2024-12-31|2024-06-30

query
select next_day('2024-03-15'::date, 'Monday'), previous_day('2024-03-15'::date, 'fr'), next_day('2024-03-15'::date, 'friday')
----
2024-03-18|2024-03-08|2024-03-22

query
select date_from_parts(2024, 2, 30), date_from_parts(2024, 13, 1), time_from_parts(12, 30, 0), timestamp_from_parts(2024, 1, 2, 3, 4, 5)
----
2024-03-01|2025-01-01|12:30:00|2024-01-02 03:04:05

query
select to_date('2024-03-15 10:00:00'), to_date('03/15/2024', 'MM/DD/YYYY'), to_date('20240315', 'YYYYMMDD'), to_time('12:34'), to_time('1:02:03 PM', 'HH12:MI:SS AM')
----
2024-03-15|2024-03-15|2024-03-15|12:34:00|13:02:03

query
select '2024-03-15'::date + 1, '2024-03-15'::date - 1, '2024-03-15'::date - '2024-03-01'::date
----
2024-03-16|2024-03-14|14

query
select date_trunc('month', '2024-03-15'::date), date_trunc('week', '2024-03-15'::date), date_trunc('quarter', '2024-05-15'::date), trunc('2024-03-15'::date, 'year')
----
2024-03-01|2024-03-11|2024-04-01|2024-01-01

query
select date_trunc(hour, '2024-03-15 10:11:12'::timestamp), date_trunc('minute', '2024-03-15 10:11:12'::timestamp), time_slice('2024-03-15 10:11:12'::timestamp, 15, 'minute')
----
2024-03-15 10:00:00|2024-03-15 10:11:00|2024-03-15 10:00:00

query
select to_char('2024-03-05'::date, 'MON DD, YYYY'), to_char('2024-03-15 13:04:05'::timestamp, 'YYYY-MM-DD HH24:MI:SS'), to_char('2024-03-15 13:04:05'::timestamp, 'HH12:MI AM'), to_varchar('2024-03-15'::date)
----
Mar 05, 2024|2024-03-15 13:04:05|01:04 PM|2024-03-15

query
select monthname('2024-03-15'::date), dayname('2024-03-17'::date), to_char('2024-03-15'::date, 'DY MMMM')
----
Mar|Sun|Fri March

query
select to_timestamp_ntz(1710497472), to_timestamp(1710497472000, 3), to_timestamp('2024-03-15 10:11:12.123'), to_timestamp_ntz('15/03/2024 10:11', 'DD/MM/YYYY HH24:MI')
----
2024-03-15 10:11:12|2024-03-15 10:11:12|2024-03-15 10:11:12.123|2024-03-15 10:11:00

query
select try_to_timestamp('x'), try_to_date('2024-02-30'), try_to_time('25:00:00'), to_date(null)
----
NULL|NULL|NULL|NULL

query
select '2024-03-15 10:00:00'::timestamp + interval '1 day 2 hours', '2024-03-15'::date + interval '1 month', '10:00:00'::time + interval '90 minutes'
----
2024-03-16 12:00:00|2024-04-15|11:30:00

query
select dateadd(ms, 1500, '2024-01-01'::timestamp), dateadd(ns, 1000, '2024-01-01'::timestamp), dateadd(qtr, 1, '2024-01-31'::date), dateadd(y, 1, '2024-01-01'::date)
----
2024-01-01 00:00:01.5|2024-01-01 00:00:00.000001|2024-04-30|2025-01-01

query types
select current_date() <= current_date, typeof(current_timestamp()::variant), sysdate() is not null, localtimestamp() is not null
----
BOOLEAN|VARCHAR|BOOLEAN|BOOLEAN
true|TIMESTAMP_LTZ|true|true

query
select '2024-03-15T10:11:12Z'::timestamp_ntz, '2024-03-15 10:11:12 +02:00'::timestamp_ntz, '1710497472'::timestamp_ntz
----
2024-03-15 10:11:12|2024-03-15 10:11:12|2024-03-15 10:11:12

query
select '2024-03-15 10:11:12 +02:00'::timestamp_tz::timestamp_ntz, convert_timezone('UTC', '2024-03-15 10:11:12 +02:00'::timestamp_tz)::timestamp_ntz
----
2024-03-15 10:11:12|2024-03-15 08:11:12

query
select convert_timezone('America/New_York', 'UTC', '2024-07-01 12:00:00'::timestamp_ntz), convert_timezone('UTC', 'Asia/Tokyo', '2024-01-01 00:00:00'::timestamp_ntz)
----
2024-07-01 16:00:00|2024-01-01 09:00:00

query
select '2024-03-15'::date = '2024-03-15 00:00:00'::timestamp, '2024-03-15'::date < '2024-03-15 00:00:01'::timestamp, '2024-03-15'::date between '2024-01-01' and '2024-12-31'
----
true|true|true

