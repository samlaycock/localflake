create table lines (line_id int, play varchar(50), character varchar(30), line varchar(2000))

statement ok
insert into lines values (1, 'Henry IV Part 1', 'KING HENRY IV', 'So shaken as we are, so wan with care,'), (2, 'Henry V', 'FALSTAFF', 'Blue,red,green'), (3, 'Twelfth Night', 'MALVOLIO', 'docs@snowflake.com and bob''s burgers')

query
select line_id, search(line, 'shaken'), search((play, character), 'henry'), search(line, 'care wan', search_mode => 'AND'), search(line, 'wan care', search_mode => 'PHRASE'), search(line, 'blue,red,green', search_mode => 'EXACT') from lines order by line_id
