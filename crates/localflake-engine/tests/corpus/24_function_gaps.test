1|true|true|true|false|false
2|false|true|false|false|true
3|false|false|false|false|false

query
select search(line, 'snowflake.com', analyzer => 'UNICODE_ANALYZER'), search(line, 'snowflake.com'), search(line, 'Blue,red,green', analyzer => 'NO_OP_ANALYZER'), search(line, 'blue,red,green', analyzer => 'NO_OP_ANALYZER') from lines order by line_id
----
false|false|false|false
false|false|true|false
true|true|false|false

