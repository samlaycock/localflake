statement ok
create table ipt (id int, ipv4_source varchar(20), ipv4_target varchar(20), ipv6_target varchar(40))

statement ok
insert into ipt values (1, '192.0.2.146', '203.0.113.5', '2001:0db8:85a3:0000:0000:8a2e:0370:7334'), (2, '192.0.2.111', '192.000.002.146', '2001:db8:1234::5678')

query
select ipv4_source, search_ip((ipv4_source, ipv4_target, ipv6_target), '192.0.2.146'), search_ip((ipv6_target), '2001:db8:85a3::8a2e:370:7334'), search_ip((ipv4_source, ipv4_target), '192.0.2.1/20'), search_ip((ipv4_source, ipv4_target), '203.000.113.005') from ipt order by ipv4_source
----
192.0.2.111|true|false|true|false
192.0.2.146|true|true|true|true

query
select search_ip('Connection from IP address 192.0.2.146 succeeded.', '192.0.2.146'), search_ip((id, ipv4_source), '192.0.2.146') from ipt order by id
----
true|true
true|false

error
select search_ip(ipv4_source, '1925.0.2.146') from ipt

