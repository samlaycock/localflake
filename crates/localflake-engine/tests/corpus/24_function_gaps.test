statement ok
create table seq_demo (c1 int)

statement ok
insert into seq_demo select seq4() + 1 from table(generator(rowcount => 8))

statement ok
create table hll_1 as select hll_accumulate(c1) as rs1 from seq_demo

statement ok
create table hll_2 as select hll_accumulate(c1 + 4) as rs1 from seq_demo

query
select hll_estimate(hll_combine(rs1)) from (select rs1 from hll_1 union all select rs1 from hll_2)
----
12

query
select hll_estimate(hll_import(hll_export(hll_accumulate(c1)))), hll_estimate(hll_accumulate(c1)) = hll(c1) from seq_demo
----
8|true

statement ok
create table pct_1 as select approx_percentile_accumulate(column1) as rs1 from values (1), (2), (3), (4)

statement ok
create table pct_2 as select approx_percentile_accumulate(column1) as rs1 from values (5), (6), (7), (8)

query
select approx_percentile_estimate(rs1, 0.5) from pct_1
----
2.5

query
select approx_percentile_estimate(approx_percentile_combine(rs1), 0.5) from (select rs1 from pct_1 union all select rs1 from pct_2)
----
4.5

statement ok
create table topk_1 as select approx_top_k_accumulate(c1, 50) as rs1 from seq_demo

statement ok
create table topk_2 as select approx_top_k_accumulate(c1 + 4, 50) as rs1 from seq_demo

query
select approx_top_k_estimate(approx_top_k_combine(rs1), 4) from (select rs1 from topk_1 union all select rs1 from topk_2)
----
[[5,2],[6,2],[7,2],[8,2]]

statement ok
create table ta (i integer)

statement ok
insert into ta select seq4() + 1 from table(generator(rowcount => 10))

query
select approximate_similarity(mh) from (select minhash(100, i) mh from ta union all select minhash(100, i) mh from ta)
----
1

query
select approximate_jaccard_index(mh) from (select minhash(100, i) mh from ta union all select minhash(100, -i) mh from ta)
----
0

query
select mh:type, mh:version, array_size(mh:state) from (select minhash(5, i) mh from ta)
----
"minhash"|1|5

query
select approximate_similarity(mh) from (select minhash_combine(mh) mh from (select minhash(100, i) mh from ta where i <= 5 union all select minhash(100, i) from ta where i > 5) union all select minhash(100, i) from ta)
----
1

