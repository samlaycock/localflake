    {
      "name": "dml/merge",
      "steps": [
        {
          "sql": "create or replace table conf_target (id int, v varchar)"
        },
        {
          "sql": "insert into conf_target values (1, 'old'), (2, 'old')"
        },
        {
          "sql": "merge into conf_target t using (select 2 as id, 'new' as v union all select 3, 'new') s on t.id = s.id when matched then update set v = s.v when not matched then insert values (s.id, s.v)",
